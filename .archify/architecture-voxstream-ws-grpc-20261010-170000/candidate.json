  "cards": [
    {
      "dot": "cyan",
      "title": "Two transports, one pipeline",
      "items": [
        "WebSocket and gRPC are enabled by default; each can be switched off by configuration",
        "Both call VoxStreamService.open_session, so validation, error codes and the single concurrency limit are identical",
        "core never imports a transport: Session emits neutral AudioFrame objects"
      ]
    },
    {
      "dot": "emerald",
      "title": "Operations",
      "items": [
        "Config: VOXSTREAM_* environment variables",
        "Logs: JSON with request id and transport, never text or audio",
        "Health is HTTP /healthz and /readyz on the WebSocket port in every mode"
      ]
    },
    {
      "dot": "rose",
      "title": "Spanish quality gate",
      "items": [
        "voxstream verify-voices transcribes audio with Whisper",
        "Only voices that pass for the installed model are served"
      ]
    }
  ]
